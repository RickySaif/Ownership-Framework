# Non-secret settings for this hub. Copy to qa.env (committed) or set them in your shell.
# Passwords and tokens never go here: they live in the OS keychain or in environment variables.

# Which environment the tools target by default: local, dev, staging or prod (prod = read-only smoke only)
QA_ENV=local

# Local database guard: database writes on "local" only happen when this names the local database
# (a file path for SQLite, a database name for PostgreSQL/MySQL). A wrong connection string can then never
# reach a shared database.
# QA_ISOLATED_DB=.local-db/my-app.db
