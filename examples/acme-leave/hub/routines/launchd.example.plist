<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS: copy to ~/Library/LaunchAgents/example.qa-hub.nightly.plist, fix the path, then:
     launchctl load ~/Library/LaunchAgents/example.qa-hub.nightly.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>example.qa-hub.nightly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string><string>-lc</string>
    <string>cd /path/to/{{hubSlug}} &amp;&amp; git pull --ff-only &amp;&amp; claude -p "$(cat routines/nightly.prompt.md)" --settings routines/permissions.json &gt;&gt; runs/launchd.log 2&gt;&amp;1</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>1</integer><key>Minute</key><integer>30</integer></dict>
</dict>
</plist>
